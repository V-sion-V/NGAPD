{
  "name": "ngapd",
  "version": "0.0.0",
  "private": true,
  "description": "NGAPD monorepo",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "pnpm build:packages && pnpm build:apps",
    "build:apps": "pnpm --filter @ngapd/workspace-cli build && pnpm --filter @ngapd/api build && pnpm --filter @ngapd/worker build && pnpm --filter @ngapd/web build",
    "build:packages": "pnpm --filter @ngapd/contracts build && pnpm --filter @ngapd/domain build && pnpm --filter @ngapd/workspace-core build && pnpm --filter @ngapd/database build && pnpm --filter @ngapd/object-store build && pnpm --filter @ngapd/test-fixtures build",
    "check": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm test",
    "ci": "node scripts/dev/with-database.mjs --scope=both -- pnpm ci:resolved",
    "ci:resolved": "pnpm ci:verify && pnpm db:migrate:resolved && pnpm db:migrate:resolved && pnpm check",
    "ci:verify": "node scripts/ci/verify-toolchain.mjs --require-database",
    "compose:smoke": "node scripts/compose/smoke.mjs",
    "reference:p95": "node scripts/performance/m1-reference-p95.mjs",
    "reference:m2:p95": "node scripts/performance/m2-reference-p95.mjs",
    "env:check": "node scripts/dev/with-database.mjs --scope=both --check",
    "db:migrate": "node scripts/dev/with-database.mjs --scope=app -- pnpm db:migrate:resolved",
    "db:migrate:resolved": "pnpm --filter @ngapd/database migrate",
    "dev": "node scripts/dev/with-database.mjs --scope=app -- pnpm dev:resolved",
    "dev:resolved": "pnpm build:packages && concurrently -n api,worker,web -c blue,magenta,green \"pnpm --filter @ngapd/api dev\" \"pnpm --filter @ngapd/worker dev\" \"pnpm --filter @ngapd/web dev\"",
    "dev:api": "node scripts/dev/with-database.mjs --scope=app -- pnpm dev:api:resolved",
    "dev:api:resolved": "pnpm build:packages && pnpm --filter @ngapd/api dev",
    "dev:workspace": "node scripts/dev/with-database.mjs --scope=none -- pnpm dev:workspace:resolved",
    "dev:workspace:resolved": "pnpm build:packages && pnpm --filter @ngapd/workspace-cli dev --",
    "dev:web": "pnpm build:packages && pnpm --filter @ngapd/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "node scripts/dev/with-database.mjs --scope=test -- pnpm test:resolved",
    "test:resolved": "pnpm -r --workspace-concurrency=1 --if-present test",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@ngapd/workspace-cli": "workspace:*",
    "@types/node": "^24.10.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.15"
  }
}
